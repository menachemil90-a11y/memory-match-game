# Online play (Supabase). The real values are in the committed `.env`.
# Fill in from Supabase dashboard → Project Settings → API. Only the URL and
# the anon key (public by design — RLS protects the data) may be committed;
# never the service_role key, a secret key, the DB password or any token.
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY
