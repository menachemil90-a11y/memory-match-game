{
  "expo": {
    "name": "Memory Match",
    "slug": "memory-match-game",
    "version": "0.3.0",
    "scheme": "memorymatch",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "backgroundColor": "#5B3FD9",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.placeholder.memorymatch",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      },
      "buildNumber": "1"
    },
    "android": {
      "package": "com.placeholder.memorymatch",
      "adaptiveIcon": {
        "backgroundColor": "#5B3FD9",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "com.google.android.finsky.permission.BIND_GET_INSTALL_REFERRER_SERVICE"
      ],
      "versionCode": 1
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#5B3FD9"
        }
      ],
      "expo-image",
      "expo-sqlite",
      [
        "expo-audio",
        {
          "microphonePermission": false,
          "recordAudioAndroid": false,
          "enableBackgroundPlayback": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow $(PRODUCT_NAME) to use the photos you choose to make your own memory cards.",
          "cameraPermission": "Allow $(PRODUCT_NAME) to take a photo for your own memory cards.",
          "microphonePermission": false
        }
      ],
      "expo-font",
      [
        "expo-localization",
        {
          "supportsRTL": false
        }
      ],
      "expo-sharing",
      "./plugins/withAndroidBuildResources"
    ],
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/5b0d0ba0-eb49-40c4-8881-b13daffe2533",
      "enabled": true,
      "checkAutomatically": "NEVER",
      "fallbackToCacheTimeout": 0
    },
    "description": "A family memory game where you can make boards from your own photos.",
    "primaryColor": "#5B3FD9",
    "extra": {
      "eas": {
        "projectId": "5b0d0ba0-eb49-40c4-8881-b13daffe2533"
      }
    }
  }
}
